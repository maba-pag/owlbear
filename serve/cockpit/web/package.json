{
  "name": "owlbear-cockpit-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint:biome": "node scripts/run-biome-check.mjs check .",
    "lint:biome:ci": "node scripts/run-biome-check.mjs ci .",
    "lint:biome:staged": "node scripts/run-biome-check.mjs check --staged --no-errors-on-unmatched",
    "format:biome": "node scripts/run-biome-check.mjs format .",
    "sync:pds": "node scripts/sync-pds-assets.mjs",
    "test:biome-pds": "node scripts/test-biome-pds.mjs",
    "lint:html": "htmlhint --config .htmlhintrc index.html",
    "preview": "vite preview",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=2048 vitest run --silent=true",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:compat": "node scripts/run-e2e-compat.mjs",
    "test:e2e:compat:all": "cross-env E2E_COMPAT_BROWSERS=chromium,firefox,webkit node scripts/run-e2e-compat.mjs",
    "test:e2e:work": "cross-env WORK_PORTFOLIO_E2E=1 playwright test --project=work-portfolio",
    "test:e2e:memory-purge": "cross-env PURGE_E2E=1 playwright test --project=memory-purge-assembled",
    "test:e2e:memory-lifecycle": "cross-env LIFECYCLE_E2E=1 playwright test --project=memory-lifecycle-assembled",
    "test:e2e:all": "node scripts/run-e2e-all.mjs"
  },
  "dependencies": {
    "@porsche-design-system/components-js": "^4.6.0",
    "@porsche-design-system/components-react": "^4.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "cross-env": "^10.1.0",
    "htmlhint": "^1.9.2",
    "jsdom": "^30.0.0",
    "lightningcss": "^1.32.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
