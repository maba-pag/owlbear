root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
max_line_length = 120
trim_trailing_whitespace = true

[*.py]
indent_size = 4

[tests/**/*.py]
max_line_length = unset

[*.md]
indent_size = unset
max_line_length = unset

# Native change YAML is schema-validated; wrapping it creates semantic diff noise
[.owlbear/changes/**/*.yaml]
max_line_length = unset

[*.excalidraw]
max_line_length = unset

# Kanban files — machine-managed YAML+markdown, allow long lines
[.owlbear/kanban/**]
max_line_length = unset

# Keep data files minified — do not reformat
[store/**]
indent_size = unset
insert_final_newline = false
max_line_length = unset
trim_trailing_whitespace = false
