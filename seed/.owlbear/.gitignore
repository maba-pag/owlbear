# --- OwlBear managed paths ---

# Scratch / ad-hoc workspace
scratch/*
!scratch/.gitkeep
!scratch/.instructions.md

# Knowledge and memory databases
knowledge/*.db
knowledge/vectors/
memory/*.db

# Delivery runtime state; keep the visible host defaults trackable
delivery/runtime/*
!delivery/runtime/host.json
delivery/worktrees/
worktrees/
delivery/migration.json
delivery/integration-retirement.json
scratch/delivery-integration-retirement/
target/target-runtime/capacity.json
target/target-runtime/integration-verification/

# Lock files (transient runtime artifacts)
.storage.lock
kanban/activity.jsonl
