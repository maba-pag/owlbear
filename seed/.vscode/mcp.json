{
  "servers": {
    "owlbear-knowledge": {
      "type": "stdio",
      "command": "${userHome}/.owlbear/runtime/.venv/bin/python",
      "args": ["-m", "owlbear_delivery_next", "serve", "knowledge"]
    },
    "owlbear-memory": {
      "type": "stdio",
      "command": "${userHome}/.owlbear/runtime/.venv/bin/python",
      "args": ["-m", "owlbear_delivery_next", "serve", "memory"]
    },
    "owlbear-browser": {
      "type": "stdio",
      "command": "${userHome}/.owlbear/runtime/.venv/bin/python",
      "args": ["-m", "owlbear_delivery_next", "serve", "browser"],
      "env": {
        "BROWSER_ALLOWED_DOMAINS": "*"
      }
    },
    "markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": ["markitdown-mcp"]
    }
  }
}
