{
  "servers": {
    "ob-kanban": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--project",
        "{{owlbear_rel_path}}",
        "run",
        "python",
        "-m",
        "owlbear_mcp_kanban"
      ],
      "env": {
        "OWLBEAR_DELIVERY_CONFIG": "{{target_abs_path}}/.owlbear/delivery-config.json",
        "OWLBEAR_WORKSPACE_ROOT": "{{target_abs_path}}"
      }
    },
    "ob-knowledge": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--project",
        "{{owlbear_rel_path}}",
        "run",
        "python",
        "-m",
        "owlbear_mcp_knowledge"
      ]
    },
    "ob-memory": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--project",
        "{{owlbear_rel_path}}",
        "run",
        "python",
        "-m",
        "owlbear_mcp_memory"
      ]
    },
    "ob-browser": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--project",
        "{{owlbear_rel_path}}",
        "run",
        "python",
        "-m",
        "owlbear_mcp_browser"
      ]
    },
    "markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "markitdown-mcp"
      ]
    }
  }
}
