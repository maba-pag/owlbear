# Node.js
node_modules/

# Python bytecode and cache
__pycache__/
*.pyc
*.pyd
*.pyo
*.egg-info

# Virtual environments
.venv/
.Python
lib/
lib64/
var/

# Build artifacts
build/
_cache
dist/
sdist/
wheels/
parts/
downloads/
.installed.cfg
MANIFEST
artifacts/

# Databases
*.db-shm
*.db-wal

# Testing and coverage
.*cache
.coverage
coverage.json
coverage.xml
htmlcov/
.hypothesis/
.benchmarks/
megalinter-reports/
test-results/
playwright-report/

# IDE and editor
.vscode/*
!.vscode/mcp.json
!.vscode/settings.json
.claude/
.serena/

# Secrets - NEVER commit
.env
.env.*
!.env.example
*.secret
*.local.toml

# Logs
*.log

# --- OwlBear managed paths ---

# Scratch / ad-hoc workspace
.owlbear/scratch/*
!.owlbear/scratch/.gitkeep
!.owlbear/scratch/.instructions.md

# Brief drafts (transient template directory)
.owlbear/briefs/draft-new/

# Knowledge and memory databases
.owlbear/knowledge/*.db
.owlbear/knowledge/vectors/
.owlbear/memory/*.db

# Host-local Delivery startup configuration
/.owlbear/delivery/config.json

# Host-local Delivery worktrees and mutable capacity ledger
/.owlbear/worktrees/
/.owlbear/target/target-runtime/capacity.json

# Lock files (transient runtime artifacts)
.owlbear/target/**/.storage.lock
.owlbear/target-cutover.pending
.coverage.*
