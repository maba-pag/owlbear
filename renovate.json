{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "security:minimumReleaseAgePypi", "customManagers:biomeVersions"],
  "baseBranchPatterns": ["main"],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "updateNotScheduled": true,
  "labels": ["dependencies", "renovate"],
  "gitIgnoredAuthors": ["github-actions[bot] <41898282+github-actions[bot]@users.noreply.github.com>"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "{{datasource}} security updates",
    "minimumReleaseAge": "6 hours",
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "highest",
    "labels": ["dependencies", "renovate", "security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 9-12 * * 5"],
    "automerge": false
  },
  "packageRules": [
    {
      "description": "Keep Python runtime floor within the supported 3.14 series",
      "matchPackageNames": ["python"],
      "matchManagers": ["pep621"],
      "allowedVersions": ">=3.14.8,<3.15.0"
    },
    {
      "description": "Freeze the checked-in Python runtime to 3.14.x",
      "matchPackageNames": ["python"],
      "matchManagers": ["pyenv"],
      "matchFileNames": [".python-version"],
      "allowedVersions": "/^3\\.14(?:\\.[0-9]+)?$/"
    },
    {
      "description": "Prefer lockfile-only updates for in-range npm dependency updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies", "optionalDependencies", "peerDependencies"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Prefer lockfile-only updates for in-range uv.lock-backed Python updates",
      "matchManagers": ["pep621"],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Keep Node runtime declarations aligned",
      "matchDatasources": ["node-version"],
      "matchPackageNames": ["node"],
      "versioning": "node",
      "groupName": "Node.js runtime",
      "rangeStrategy": "bump"
    },
    {
      "description": "Group routine version updates by ecosystem on Friday",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "{{datasource}} minor/patch updates",
      "schedule": ["* 9-12 * * 5"],
      "prCreation": "immediate",
      "automerge": false
    },
    {
      "description": "Give Docker routine updates a one-day maturity floor",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "24 hours"
    },
    {
      "description": "Lint toolchain: every pre-commit hook in one weekly pull request",
      "matchManagers": ["pre-commit"],
      "groupName": "lint toolchain",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Lint toolchain: Ruff and Biome join the hooks, so their parity checks see one version",
      "matchPackageNames": ["ruff", "@biomejs/biome"],
      "groupName": "lint toolchain",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group integrity updates by ecosystem on Friday",
      "matchUpdateTypes": ["pin", "pinDigest", "digest"],
      "groupName": "{{datasource}} integrity updates",
      "schedule": ["* 9-12 * * 5"],
      "automerge": false
    },
    {
      "description": "Open major version updates on Sunday",
      "matchUpdateTypes": ["major"],
      "schedule": ["* 12-15 * * 0"],
      "minimumReleaseAge": "72 hours",
      "prCreation": "immediate",
      "automerge": false
    }
  ],
  "pre-commit": {
    "enabled": true
  }
}
