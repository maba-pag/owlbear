{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":preserveSemverRanges"
  ],
  "baseBranchPatterns": [
    "dev"
  ],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "updateNotScheduled": true,
  "labels": [
    "dependencies",
    "renovate"
  ],
  "rangeStrategy": "update-lockfile",
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": "{{datasource}} security updates",
    "schedule": [
      "* 9-11 * * 1,5"
    ],
    "minimumReleaseAge": "6 hours",
    "prCreation": "immediate",
    "vulnerabilityFixStrategy": "highest",
    "labels": [
      "dependencies",
      "renovate",
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "* 9-11 * * 5"
    ],
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Freeze Python runtime floor to 3.12.x",
      "matchPackageNames": [
        "python"
      ],
      "matchManagers": [
        "pep621",
        "uv"
      ],
      "allowedVersions": "<3.13.0"
    },
    {
      "description": "Group routine version updates by ecosystem on Friday",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "{{datasource}} minor/patch updates",
      "schedule": [
        "* 9-11 * * 5"
      ],
      "minimumReleaseAge": "24 hours",
      "prCreation": "immediate",
      "automerge": true
    },
    {
      "description": "Group integrity updates by ecosystem on Friday",
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "groupName": "{{datasource}} integrity updates",
      "schedule": [
        "* 9-11 * * 5"
      ],
      "automerge": true
    },
    {
      "description": "Review Porsche Design System updates with refreshed self-hosted assets",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@porsche-design-system/components-js",
        "@porsche-design-system/components-react"
      ],
      "labels": [
        "dependencies",
        "renovate",
        "cockpit",
        "pds"
      ],
      "automerge": false
    },
    {
      "description": "Open major version updates on Sunday",
      "matchUpdateTypes": [
        "major"
      ],
      "schedule": [
        "* 11-13 * * 0"
      ],
      "minimumReleaseAge": "72 hours",
      "prCreation": "immediate",
      "automerge": false
    },
    {
      "description": "Keep Porsche Design System major versions coupled",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "@porsche-design-system/components-js",
        "@porsche-design-system/components-react"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Porsche Design System major updates"
    },
    {
      "description": "Keep Vite and its build plugins coupled on major updates",
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react",
        "@rolldown/plugin-babel",
        "babel-plugin-react-compiler"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "Vite major updates"
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "MegaLinter Docker image in pre-commit local hook",
      "managerFilePatterns": [
        "/^\\.pre-commit-config\\.yaml$/"
      ],
      "matchStrings": ["ghcr\\.io/oxsecurity/megalinter-cupcake:v(?<currentValue>[\\d.]+)"],
      "depNameTemplate": "ghcr.io/oxsecurity/megalinter-cupcake",
      "datasourceTemplate": "docker"
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/pyproject\\.toml$/"
    ]
  }
}
