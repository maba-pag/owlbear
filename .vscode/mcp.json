{
  "servers": {
    "owlbear-knowledge": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "owlbear_knowledge_mcp"]
    },
    "owlbear-memory": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "owlbear_memory_mcp"]
    },
    "owlbear-browser": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "python", "-m", "owlbear_browser_mcp"]
    },
    "owlbear-delivery": {
      "type": "stdio",
      "command": "${userHome}/.owlbear/runtime/.venv/bin/python",
      "args": ["-m", "owlbear_delivery_next", "mcp", "--repo", "${workspaceFolder}"]
    }
  }
}
