{
    "servers": {
        "owlbear-delivery": {
            "type": "stdio",
            "command": "uv",
            "args": [
                "--project",
                "../owlbear-dev",
                "run",
                "python",
                "-m",
                "owlbear_delivery_mcp"
            ],
            "env": {
                "UV_CERT": "${env:NODE_EXTRA_CA_CERTS}",
                "SSL_CERT_FILE": "${env:NODE_EXTRA_CA_CERTS}",
                "REQUESTS_CA_BUNDLE": "${env:NODE_EXTRA_CA_CERTS}",
                "CURL_CA_BUNDLE": "${env:NODE_EXTRA_CA_CERTS}",
                "PIP_CERT": "${env:NODE_EXTRA_CA_CERTS}"
            }
        },
