{
  "[chatagent]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[instructions]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "[prompt]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[skill]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "accessibility.chat.showCheckmarks": true,
  "chat.agent.maxRequests": 99999,
  "chat.agentFilesLocations": {
    "../owlbear/share/agents": true,
    ".owlbear/agents": true
  },
  "chat.agentSkillsLocations": {
    "../owlbear/share/skills": true,
    ".owlbear/skills": true
  },
  "chat.autopilot.enabled": true,
  "chat.checkpoints.showFileChanges": true,
  "chat.instructionsFilesLocations": {
    "../owlbear/share/instructions": true,
    ".owlbear/instructions": true
  },
  "chat.mcp.gallery.enabled": true,
  "chat.notifyWindowOnConfirmation": "always",
  "chat.notifyWindowOnResponseReceived": "always",
  "chat.promptFilesLocations": {
    "../owlbear/share/prompts": true,
    ".owlbear/prompts": true
  },
  "chat.subagents.allowInvocationsFromSubagents": true,
  "chat.tools.terminal.autoApprove": {
    "Test-Path": true,
    "uv run coverage": true,
    "uv run pytest": true,
    "uv run python": true,
    "uv run ruff": true
  },
  "chat.tools.terminal.blockDetectedFileWrites": "never",
  "chat.tools.urls.autoApprove": {
    "*": true
  },
  "chat.useCustomAgentHooks": true,
  "chat.viewSessions.orientation": "stacked",
  "diffEditor.hideUnchangedRegions.enabled": false,
  "editor.defaultFormatter": "charliermarsh.ruff",
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,
  "editor.links": false,
  "editor.maxTokenizationLineLength": 2500,
  "extensions.experimental.affinity": {
    "charliermarsh.ruff": 3,
    "ms-python.vscode-pylance": 2
  },
  "files.eol": "\n",
  "files.exclude": {
    ".venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  },
  "files.watcherExclude": {
    ".owlbear/kanban/**": true
  },
  "git.autorefresh": false,
  "github.copilot.chat.agent.autoFix": false,
  "github.copilot.chat.agent.currentEditorContext.enabled": false,
  "github.copilot.chat.anthropic.thinking.budgetTokens": 32000,
  "github.copilot.chat.cli.forkSessions.enabled": true,
  "github.copilot.chat.cli.sessionController.enabled": true,
  "github.copilot.chat.copilotMemory.enabled": false,
  "github.copilot.chat.executionSubagent.enabled": true,
  "github.copilot.chat.executionSubagent.toolCallLimit": 50,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.newWorkspaceCreation.enabled": false,
  "github.copilot.chat.searchSubagent.enabled": true,
  "github.copilot.chat.searchSubagent.toolCallLimit": 50,
  "github.copilot.chat.tools.memory.enabled": true,
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.nextEditSuggestions.extendedRange": true,
  "inlineChat.enableV2": true,
  "json.maxItemsComputed": 5000,
  "MS-CST-E.vscode-devskim.rules.enableBestPracticeSeverityRules": true,
  "MS-CST-E.vscode-devskim.rules.enableManualReviewSeverityRules": true,
  "python.analysis.aiCodeActions": {
    "convertFormatString": true,
    "convertLambdaToNamedFunction": true,
    "generateDocstring": true,
    "generateSymbol": true,
    "implementAbstractClasses": true
  },
  "python.analysis.aiHoverSummaries": true,
  "python.analysis.fixAll": [
    "source.unusedImports"
  ],
  "python.analysis.typeCheckingMode": "standard",
  "python.terminal.useEnvFile": true,
  "python.testing.pytestEnabled": true,
  "redhat.telemetry.enabled": false,
  "ruff.importStrategy": "useBundled",
  "scm.defaultViewMode": "tree",
  "scm.graph.pageOnScroll": false,
  "search.exclude": {
    ".owlbear/kanban/activity.jsonl": true,
    ".owlbear/kanban/archive/**": true,
    ".owlbear/scratch/**": true,
    ".venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  },
  "sortJSON.contextMenu": {
    "sortJSON": false,
    "sortJSONAlphaNum": true,
    "sortJSONAlphaNumReverse": false,
    "sortJSONKeyLength": false,
    "sortJSONKeyLengthReverse": false,
    "sortJSONReverse": false,
    "sortJSONType": false,
    "sortJSONTypeReverse": false,
    "sortJSONValues": false,
    "sortJSONValuesReverse": false
  },
  "task.problemMatchers.neverPrompt": true,
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "terminal.integrated.defaultProfile.windows": "pwsh",
  "terminal.integrated.enableFileLinks": "off",
  "terminal.integrated.profiles.windows": {
    "pwsh": {
      "icon": "terminal-powershell",
      "path": "${env:HOMEDRIVE}${env:HOMEPATH}\\Coding\\pwsh\\pwsh.exe"
    }
  },
  "terminal.integrated.wordSeparators": "",
  "workbench.settings.alwaysShowAdvancedSettings": true,
  "workbench.startupEditor": "none"
}
