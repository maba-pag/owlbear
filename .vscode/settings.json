{
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[xml]": {
    "editor.defaultFormatter": "redhat.vscode-xml"
  },
  "accessibility.chat.showCheckmarks": true,
  "chat.agent.maxRequests": 99999,
  "chat.agentFilesLocations": {
    ".owlbear/agents": true,
    "share/agents": true
  },
  "chat.agentHost.copilot.toolSearch.enabled": true,
  "chat.agentSkillsLocations": {
    ".owlbear/skills": true,
    "share/skills": true
  },
  "chat.checkpoints.showFileChanges": true,
  "chat.generalPurposeAgent.enabled": true,
  "chat.instructionsFilesLocations": {
    ".owlbear/instructions": true,
    "share/instructions": true
  },
  "chat.mcp.gallery.enabled": true,
  "chat.notifyWindowOnConfirmation": "always",
  "chat.notifyWindowOnResponseReceived": "always",
  "chat.promptFilesLocations": {
    ".owlbear/prompts": true,
    "share/prompts": true
  },
  "chat.subagents.allowInvocationsFromSubagents": true,
  "chat.tools.compressOutput.enabled": true,
  "chat.tools.terminal.autoApprove": {
    "npm test": true,
    "Test-Path": true,
    "uv run coverage": true,
    "uv run eslint-fix": true,
    "uv run help": true,
    "uv run lint": true,
    "uv run lint --all": true,
    "uv run lint-full": true,
    "uv run megalint": true,
    "uv run pytest": true,
    "uv run python": true,
    "uv run ruff": true,
    "uv run todo": true
  },
  "chat.tools.terminal.blockDetectedFileWrites": "never",
  "chat.tools.urls.autoApprove": {
    "*": true
  },
  "chat.viewSessions.orientation": "stacked",
  "diffEditor.hideUnchangedRegions.enabled": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,
  "editor.links": false,
  "editor.maxTokenizationLineLength": 2500,
  "eslint.workingDirectories": [
    {
      "directory": "serve/cockpit/web"
    }
  ],
  "extensions.experimental.affinity": {
    "charliermarsh.ruff": 3,
    "ms-python.vscode-pylance": 2
  },
  "files.eol": "\n",
  "files.exclude": {
    ".venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  },
  "files.watcherExclude": {
    ".owlbear/kanban/**": true
  },
  "git.autorefresh": false,
  // NOTE: User-local absolute path — update to your owlbear install location.
  // On Windows this might be e.g. "C:\\Users\\you\\Projects\\owlbear".
  "github.copilot.chat.additionalReadAccessPaths": [
    "/Users/markus/Projects/owlbear"
  ],
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.anthropic.contextEditing.mode": "clear-tooluse",
  "github.copilot.chat.cli.sessionController.enabled": true,
  "github.copilot.chat.executionSubagent.enabled": true,
  "github.copilot.chat.executionSubagent.toolCallLimit": 50,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.githubMcpServer.toolsets": [
    "actions",
    "issues",
    "pull_requests"
  ],
  "github.copilot.chat.newWorkspaceCreation.enabled": false,
  "github.copilot.chat.searchSubagent.enabled": true,
  "github.copilot.chat.searchSubagent.toolCallLimit": 50,
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": true
  },
  "json.maxItemsComputed": 5000,
  "MS-CST-E.vscode-devskim.rules.enableBestPracticeSeverityRules": true,
  "MS-CST-E.vscode-devskim.rules.enableManualReviewSeverityRules": true,
  "python.analysis.aiCodeActions": {
    "convertFormatString": true,
    "convertLambdaToNamedFunction": true,
    "generateDocstring": true,
    "generateSymbol": true,
    "implementAbstractClasses": true
  },
  "python.analysis.aiHoverSummaries": true,
  "python.analysis.fixAll": [
    "source.unusedImports"
  ],
  "python.analysis.typeCheckingMode": "standard",
  "python.terminal.useEnvFile": true,
  "python.testing.pytestEnabled": true,
  "redhat.telemetry.enabled": false,
  "ruff.importStrategy": "fromEnvironment",
  "scm.defaultViewMode": "tree",
  "scm.graph.pageOnScroll": false,
  "search.exclude": {
    ".owlbear/kanban/activity.jsonl": true,
    ".owlbear/kanban/archive/**": true,
    ".owlbear/scratch/**": true,
    ".venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  },
  "sortJSON.contextMenu": {
    "sortJSON": false,
    "sortJSONAlphaNum": true,
    "sortJSONAlphaNumReverse": false,
    "sortJSONKeyLength": false,
    "sortJSONKeyLengthReverse": false,
    "sortJSONReverse": false,
    "sortJSONType": false,
    "sortJSONTypeReverse": false,
    "sortJSONValues": false,
    "sortJSONValuesReverse": false
  },
  "task.problemMatchers.neverPrompt": true,
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "terminal.integrated.defaultProfile.windows": "pwsh",
  "terminal.integrated.enableFileLinks": "off",
  "terminal.integrated.profiles.windows": {
    "pwsh": {
      "icon": "terminal-powershell",
      "path": "pwsh"
    }
  },
  "terminal.integrated.wordSeparators": "",
  "workbench.settings.alwaysShowAdvancedSettings": true
}
