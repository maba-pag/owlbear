{
  "[javascript][javascriptreact][jsonc][typescript][typescriptreact][css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome",
    "editor.formatOnSave": false
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "accessibility.chat.showCheckmarks": true,
  "biome.lsp.bin": {
    "darwin-arm64": "node_modules/@biomejs/cli-darwin-arm64/biome",
    "darwin-x64": "node_modules/@biomejs/cli-darwin-x64/biome",
    "linux-arm64": "node_modules/@biomejs/cli-linux-arm64/biome",
    "linux-arm64-musl": "node_modules/@biomejs/cli-linux-arm64-musl/biome",
    "linux-x64": "node_modules/@biomejs/cli-linux-x64/biome",
    "linux-x64-musl": "node_modules/@biomejs/cli-linux-x64-musl/biome"
  },
  "biome.requireConfiguration": true,
  "chat.agent.maxRequests": 99999,
  "chat.agentFilesLocations": {
    ".owlbear/agents": true,
    "share/agents": true
  },
  "chat.agentHost.copilot.toolSearch.enabled": false,
  "chat.agentSkillsLocations": {
    ".owlbear/skills": true,
    "share/skills": true
  },
  "chat.checkpoints.showFileChanges": true,
  "chat.instructionsFilesLocations": {
    ".owlbear/instructions": true,
    "share/instructions": true
  },
  "chat.mcp.gallery.enabled": true,
  "chat.notifyWindowOnConfirmation": "always",
  "chat.notifyWindowOnResponseReceived": "always",
  "chat.subagents.allowInvocationsFromSubagents": true,
  "chat.tools.compressOutput.enabled": true,
  "chat.tools.terminal.autoApprove": {
    "uv run coverage": true,
    "uv run format": true,
    "uv run help": true,
    "uv run lint": true,
    "uv run pytest": true,
    "uv run python": true,
    "uv run quality": true,
    "uv run ruff": true,
    "uv run todo": true
  },
  "chat.tools.terminal.blockDetectedFileWrites": "never",
  "chat.tools.urls.autoApprove": {
    "*": true
  },
  "chat.viewSessions.orientation": "stacked",
  "diffEditor.hideUnchangedRegions.enabled": false,
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,
  "editor.links": false,
  "editor.maxTokenizationLineLength": 2500,
  "extensions.experimental.affinity": {
    "charliermarsh.ruff": 3,
    "ms-python.vscode-pylance": 2
  },
  "files.eol": "\n",
  "files.exclude": {
    ".venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  },
  "files.watcherExclude": {
    ".owlbear/controller/**": true,
    ".owlbear/kanban/**": true
  },
  "git.autorefresh": false,
  // NOTE: User-local absolute path — update to your owlbear install location.
  "github.copilot.chat.additionalReadAccessPaths": ["/Users/markus/Projects/owlbear"],
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.anthropic.contextEditing.mode": "clear-tooluse",
  "github.copilot.chat.executionSubagent.enabled": true,
  "github.copilot.chat.executionSubagent.toolCallLimit": 50,
  "github.copilot.chat.githubMcpServer.enabled": true,
  "github.copilot.chat.githubMcpServer.toolsets": ["actions", "issues", "pull_requests"],
  "github.copilot.chat.newWorkspaceCreation.enabled": false,
  "github.copilot.chat.searchSubagent.enabled": true,
  "github.copilot.chat.searchSubagent.toolCallLimit": 50,
  "github.copilot.enable": {
    "*": false,
    "markdown": false,
    "plaintext": false,
    "scminput": true
  },
  "json.maxItemsComputed": 5000,
  "npm.packageManager": "npm",
  "python.testing.pytestEnabled": true,
  "redhat.telemetry.enabled": false,
  "ruff.importStrategy": "fromEnvironment",
  "scm.defaultViewMode": "tree",
  "scm.graph.pageOnScroll": false,
  "search.exclude": {
    ".owlbear/controller/**": true,
    ".owlbear/kanban/activity.jsonl": true,
    ".owlbear/kanban/archive/**": true,
    ".owlbear/scratch/**": true,
    ".venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/*.egg-info": true
  },
  "sortJSON.contextMenu": {
    "sortJSON": false,
    "sortJSONAlphaNum": true,
    "sortJSONAlphaNumReverse": false,
    "sortJSONKeyLength": false,
    "sortJSONKeyLengthReverse": false,
    "sortJSONReverse": false,
    "sortJSONType": false,
    "sortJSONTypeReverse": false,
    "sortJSONValues": false,
    "sortJSONValuesReverse": false
  },
  "task.problemMatchers.neverPrompt": true,
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "terminal.integrated.enableFileLinks": "off",
  "terminal.integrated.wordSeparators": "",
  "workbench.settings.alwaysShowAdvancedSettings": true
}
