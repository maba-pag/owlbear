{
    "[chatagent]":  {
                        "editor.defaultFormatter":  "esbenp.prettier-vscode"
                    },
    "[instructions]":  {
                           "editor.defaultFormatter":  "esbenp.prettier-vscode"
                       },
    "[json]":  {
                   "editor.defaultFormatter":  "vscode.json-language-features",
                   "editor.formatOnSave":  false
               },
    "[jsonc]":  {
                    "editor.defaultFormatter":  "vscode.json-language-features"
                },
    "[markdown]":  {
                       "editor.defaultFormatter":  "DavidAnson.vscode-markdownlint"
                   },
    "[powershell]":  {
                         "editor.defaultFormatter":  "ms-vscode.powershell"
                     },
    "[toml]":  {
                   "editor.defaultFormatter":  "tamasfe.even-better-toml"
               },
    "[xml]":  {
                  "editor.defaultFormatter":  "redhat.vscode-xml"
              },
    "[yaml]":  {
                   "editor.defaultFormatter":  "esbenp.prettier-vscode"
               },
    "accessibility.chat.showCheckmarks":  true,
    "chat.agent.maxRequests":  99999,
    "chat.agentSessionProjection.enabled":  true,
    "chat.autopilot.enabled":  true,
    "chat.checkpoints.showFileChanges":  true,
    "chat.editing.autoAcceptDelay":  15,
    "chat.editing.explainChanges.enabled":  true,
    "chat.mcp.gallery.enabled":  true,
    "chat.notifyWindowOnConfirmation":  "always",
    "chat.notifyWindowOnResponseReceived":  "always",
    "chat.subagents.allowInvocationsFromSubagents":  true,
    "chat.tools.edits.autoApprove":  {
                                         "**/.git/**":  false,
                                         "**/.vscode/*.json":  false,
                                         "**/{package.json,package-lock.json,server.xml,build.rs,web.config,.gitattributes,.env}":  false,
                                         "**/*":  true,
                                         "**/*.{code-workspace,csproj,fsproj,vbproj,vcxproj,proj,targets,props}":  false
                                     },
    "chat.tools.terminal.autoApprove":  {
                                            "ForEach-Object":  true,
                                            "kanban\\kanban-md.exe":  true,
                                            "Out-File":  true,
                                            "Tee-Object":  true,
                                            "Test-Path":  true,
                                            "uv run coverage":  true,
                                            "uv run pytest":  true,
                                            "uv run python":  true,
                                            "uv run ruff":  true
                                        },
    "chat.tools.terminal.autoReplyToPrompts":  true,
    "chat.tools.terminal.blockDetectedFileWrites":  "never",
    "chat.tools.terminal.preventShellHistory":  false,
    "chat.tools.terminal.sandbox.enabled":  true,
    "chat.tools.urls.autoApprove":  {
                                        "*":  true
                                    },
    "chat.viewSessions.orientation":  "stacked",
    "diffEditor.hideUnchangedRegions.enabled":  true,
    "editor.defaultFormatter":  "charliermarsh.ruff",
    "editor.formatOnPaste":  true,
    "editor.formatOnSave":  true,
    "extensions.experimental.affinity":  {
                                             "charliermarsh.ruff":  3,
                                             "github.copilot":  1,
                                             "github.copilot-chat":  1,
                                             "ms-python.vscode-pylance":  2
                                         },
    "files.exclude":  {
                          ".venv":  true,
                          "**/__pycache__":  true,
                          "**/.pytest_cache":  true,
                          "**/.ruff_cache":  true,
                          "**/*.egg-info":  true,
                          "docs/scratch":  true,
                          "v1/.venv":  true
                      },
    "github.copilot.chat.agent.autoFix":  true,
    "github.copilot.chat.agent.currentEditorContext.enabled":  false,
    "github.copilot.chat.anthropic.thinking.budgetTokens":  32000,
    "github.copilot.chat.anthropic.tools.websearch.maxUses":  20,
    "github.copilot.chat.cli.forkSessions.enabled":  true,
    "github.copilot.chat.executionSubagent.enabled":  true,
    "github.copilot.chat.executionSubagent.toolCallLimit":  50,
    "github.copilot.chat.githubMcpServer.enabled":  true,
    "github.copilot.chat.newWorkspaceCreation.enabled":  false,
    "github.copilot.chat.searchSubagent.enabled":  true,
    "github.copilot.chat.searchSubagent.toolCallLimit":  50,
    "github.copilot.chat.tools.memory.enabled":  true,
    "github.copilot.enable":  {
                                  "*":  true,
                                  "plaintext":  false,
                                  "markdown":  false,
                                  "scminput":  false
                              },
    "github.copilot.nextEditSuggestions.enabled":  true,
    "github.copilot.nextEditSuggestions.extendedRange":  true,
    "gitlens.ai.model":  "vscode",
    "gitlens.ai.vscode.model":  "copilot:gpt-4.1",
    "inlineChat.enableV2":  true,
    "MS-CST-E.vscode-devskim.rules.enableBestPracticeSeverityRules":  true,
    "MS-CST-E.vscode-devskim.rules.enableManualReviewSeverityRules":  true,
    "python.analysis.aiCodeActions":  {
                                          "convertFormatString":  true,
                                          "convertLambdaToNamedFunction":  true,
                                          "generateDocstring":  true,
                                          "generateSymbol":  true,
                                          "implementAbstractClasses":  true
                                      },
    "python.analysis.aiHoverSummaries":  true,
    "python.analysis.fixAll":  [
                                   "source.unusedImports"
                               ],
    "python.analysis.typeCheckingMode":  "standard",
    "python.terminal.useEnvFile":  true,
    "python.testing.pytestEnabled":  true,
    "redhat.telemetry.enabled":  false,
    "ruff.importStrategy":  "useBundled",
    "search.exclude":  {
                           ".venv":  true,
                           "**/__pycache__":  true,
                           "**/.pytest_cache":  true,
                           "**/.ruff_cache":  true,
                           "**/*.egg-info":  true,
                           "docs/scratch/**":  true,
                           "kanban/activity.jsonl":  true,
                           "kanban/v1-archive/**":  true,
                           "v1/.venv":  true,
                           "v1/**":  true
                       },
    "sortJSON.contextMenu":  {
                                 "sortJSON":  false,
                                 "sortJSONAlphaNum":  true,
                                 "sortJSONAlphaNumReverse":  false,
                                 "sortJSONKeyLength":  false,
                                 "sortJSONKeyLengthReverse":  false,
                                 "sortJSONReverse":  false,
                                 "sortJSONType":  false,
                                 "sortJSONTypeReverse":  false,
                                 "sortJSONValues":  false,
                                 "sortJSONValuesReverse":  false
                             },
    "telemetry.editStats.enabled":  false,
    "telemetry.feedback.enabled":  false,
    "terminal.integrated.defaultProfile.windows":  "PowerShell",
    "workbench.settings.alwaysShowAdvancedSettings":  true,
    "workbench.startupEditor":  "none",
    "github.copilot.chat.cli.sessionController.enabled":  true,
    "github.copilot.chat.copilotMemory.enabled":  true,
    "chat.agentFilesLocations":  {
                                     ".github/agents":  true,
                                     "agents":  true
                                 },
    "chat.agentSkillsLocations":  {
                                      ".github/skills":  true,
                                      "skills":  true
                                  },
    "chat.instructionsFilesLocations":  {
                                            ".github/instructions":  true,
                                            "instructions":  true
                                        }
}
