{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "serve/cockpit/web/src/**/*.js",
      "serve/cockpit/web/src/**/*.mjs",
      "serve/cockpit/web/src/**/*.ts",
      "serve/cockpit/web/src/**/*.tsx",
      "serve/cockpit/web/e2e/**/*.js",
      "serve/cockpit/web/e2e/**/*.mjs",
      "serve/cockpit/web/e2e/**/*.ts",
      "serve/cockpit/web/e2e/**/*.tsx",
      "serve/cockpit/web/src/**/*.css",
      "**/*.json",
      "**/*.jsonc",
      "!**/.owlbear/delivery/packages",
      "!**/.owlbear/delivery/runtime",
      "!**/.owlbear/memory",
      "!**/.owlbear/research",
      "!**/.owlbear/sources",
      "!**/store/audit/*.db",
      "!**/store/knowledge/*.db"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noEmptyBlock": "error",
        "noUnknownAtRules": {
          "level": "error",
          "options": {
            "ignore": [
              "theme",
              "utility",
              "apply",
              "source",
              "reference",
              "variant",
              "custom-variant",
              "plugin"
            ]
          }
        }
      },
      "nursery": {
        "noDuplicateSelectors": "error"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "assist": {
    "enabled": true
  },
  "plugins": ["./serve/cockpit/web/plugins/pds-component-wrappers.grit"],
  "css": {
    "linter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  }
}
