{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "serve/cockpit/web/src/**/*.js",
      "serve/cockpit/web/src/**/*.mjs",
      "serve/cockpit/web/src/**/*.ts",
      "serve/cockpit/web/src/**/*.tsx",
      "serve/cockpit/web/e2e/**/*.js",
      "serve/cockpit/web/e2e/**/*.mjs",
      "serve/cockpit/web/e2e/**/*.ts",
      "serve/cockpit/web/e2e/**/*.tsx",
      "serve/cockpit/web/src/**/*.css",
      ".github/renovate.json",
      ".github/sync-manifest.json",
      ".markdownlint-cli2.jsonc",
      ".markdownlint.json",
      "package.json",
      "serve/cockpit/web/package.json",
      "serve/cockpit/web/tsconfig.json",
      "serve/cockpit/web/tsconfig.e2e.json",
      "serve/cockpit/web/.stylelintrc.json"
    ]
  },
  "linter": {
    "enabled": true
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true
  },
  "assist": {
    "enabled": true
  },
  "plugins": [
    "./serve/cockpit/web/plugins/pds-component-wrappers.grit"
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
