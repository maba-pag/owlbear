{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "enabled": true
  },
  "files": {
    "includes": [
      "**/*.json",
      "**/*.jsonc",
      "!**/scratch",
      "!**/worktrees",
      "!**/.owlbear/controller",
      "!**/.owlbear/delivery/packages",
      "!**/.owlbear/delivery/runtime",
      "!**/.owlbear/legacy",
      "!**/.owlbear/memory",
      "!**/.owlbear/research",
      "!**/.owlbear/sources",
      "!**/.owlbear/target"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
