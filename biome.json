{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "assist": {
    "enabled": true
  },
  "files": {
    "includes": [
      "**/*.json",
      "**/*.jsonc",
      "!**/scratch",
      "!**/worktrees",
      "!**/.owlbear/controller",
      "!**/.owlbear/delivery/packages",
      "!**/.owlbear/delivery/runtime",
      "!**/.owlbear/legacy",
      "!**/.owlbear/memory",
      "!**/.owlbear/research",
      "!**/.owlbear/sources",
      "!**/.owlbear/target"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 120,
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["serve/delivery-next/src/owlbear_delivery_next/design_pack.json"],
      "formatter": {
        "enabled": false
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
