{
  // Ignores for markdownlint-cli2 consumers: the pre-commit hook and the VS Code extension.
  // Rules live in .markdownlint.json, which markdownlint-cli2 also reads.
  "ignores": [
    ".owlbear/delivery/packages/**",
    ".owlbear/delivery/runtime/**",
    ".owlbear/doc-index.md",
    ".owlbear/py-index.md",
    ".owlbear/ts-index.md",
    ".owlbear/memory/**",
    ".owlbear/research/**",
    ".venv/**",
    "**/node_modules/**",
    "**/scratch/**",
    "**/test-results/**",
    "**/worktrees/**",
    "megalinter-reports/**"
  ]
}
