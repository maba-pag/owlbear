{
  // For local markdownlint runs. Keep aligned with both exclusion settings in .mega-linter.yml.
  "ignores": [
    ".owlbear/completed/**",
    ".owlbear/delivery/packages/**",
    ".owlbear/delivery/runtime/**",
    ".owlbear/doc-index.md",
    ".owlbear/py-index.md",
    ".owlbear/ts-index.md",
    ".owlbear/kanban/archive/**",
    ".owlbear/legacy/**",
    ".owlbear/memory/**",
    ".owlbear/research/**",
    ".owlbear/sources/**",
    ".owlbear/target/**",
    ".venv/**",
    "**/node_modules/**",
    "**/scratch/**",
    "**/test-results/**",
    "**/worktrees/**",
    "megalinter-reports/**"
  ]
}
