{
  // For local markdownlint runs. Keep aligned with FILTER_REGEX_EXCLUDE in .mega-linter.yml.
  "ignores": [
    ".owlbear/delivery/packages/**",
    ".owlbear/doc-index.md",
    ".owlbear/kanban/archive/**",
    ".owlbear/legacy/**",
    ".owlbear/research/**",
    ".owlbear/memory/**",
    ".owlbear/sources/**",
    ".venv/**",
    "**/node_modules/**",
    "**/test-results/**",
    "megalinter-reports/**"
  ]
}
