{
  "mcpServers": {
    "owlbear-browser": {
      "type": "stdio",
      "command": "${HOME}/.owlbear/runtime/.venv/bin/python",
      "args": ["-m", "owlbear_delivery_next", "serve", "browser"],
      "env": { "BROWSER_ALLOWED_DOMAINS": "*" },
      "tools": ["*"]
    },
    "owlbear-delivery": {
      "type": "stdio",
      "command": "${HOME}/.owlbear/runtime/.venv/bin/python",
      "args": ["-m", "owlbear_delivery_next", "mcp"],
      "tools": ["*"]
    },
    "owlbear-knowledge": {
      "type": "stdio",
      "command": "${HOME}/.owlbear/runtime/.venv/bin/python",
      "args": ["-m", "owlbear_delivery_next", "serve", "knowledge"],
      "tools": ["*"]
    },
    "owlbear-memory": {
      "type": "stdio",
      "command": "${HOME}/.owlbear/runtime/.venv/bin/python",
      "args": ["-m", "owlbear_delivery_next", "serve", "memory"],
      "tools": ["*"]
    }
  }
}
