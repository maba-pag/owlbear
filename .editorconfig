root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Test files — long assertion messages are acceptable (ruff E501 also suppressed)
[tests/**/*.py]
max_line_length = unset

[serve/*/tests/**/*.py]
max_line_length = unset

[*.md]
indent_size = unset
max_line_length = unset

# Delivery runtime is machine-managed structured state
[.owlbear/delivery/runtime/**]
max_line_length = unset

# Legacy records are preserved machine-managed state; do not reformat them
[.owlbear/legacy/**]
max_line_length = unset

# Design packages are Delivery-managed canonical records; do not reformat them
[.owlbear/delivery/packages/**]
max_line_length = unset

# Vendored Porsche Design System loader and stylesheet for the delivery-next Changes page — minified vendor output
[serve/delivery-next/src/owlbear_delivery_next/web/pds/**]
max_line_length = unset

# Vendored lit-html for the delivery-next pages (TD-264) — unmodified minified npm output
[serve/delivery-next/src/owlbear_delivery_next/web/vendor/**]
max_line_length = unset

[uv.lock]
max_line_length = unset

[package-lock.json]
max_line_length = unset

# Keep data files minified — do not reformat
[store/**]
indent_size = unset
max_line_length = unset
trim_trailing_whitespace = false
