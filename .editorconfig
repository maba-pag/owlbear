root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Test files — long assertion messages are acceptable (ruff E501 also suppressed)
[tests/**/*.py]
max_line_length = unset

[serve/*/tests/**/*.py]
max_line_length = unset

# Cockpit frontend — Tailwind utility classes make 120-char limits impractical
[serve/cockpit/web/src/**/*.{ts,tsx}]
max_line_length = unset

[serve/cockpit/web/e2e/**/*.ts]
max_line_length = unset

[*.md]
indent_size = unset
max_line_length = unset

# Native change YAML is schema-validated; wrapping it creates semantic diff noise
[.owlbear/changes/**/*.yaml]
max_line_length = unset

# Excalidraw diagrams — JSON with embedded base64; line length not enforceable
[*.excalidraw]
end_of_line = unset
max_line_length = unset
trim_trailing_whitespace = false

# Generated Porsche Design System assets — minified vendor output
[serve/cockpit/web/public/porsche-design-system/**]
end_of_line = unset
indent_size = unset
insert_final_newline = false
max_line_length = unset
trim_trailing_whitespace = false

# MegaLinter config — regex patterns cannot be split
[.mega-linter.yml]
max_line_length = unset

[uv.lock]
max_line_length = unset

[package-lock.json]
max_line_length = unset

[serve/cockpit/web/package-lock.json]
max_line_length = unset

# Keep data files minified — do not reformat
[store/**]
indent_size = unset
insert_final_newline = false
max_line_length = unset
trim_trailing_whitespace = false
