root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
max_line_length = 120
trim_trailing_whitespace = true

[*.py]
indent_size = 4

# Test files — long assertion messages are acceptable (ruff E501 also suppressed)
[tests/**/*.py]
max_line_length = unset

[serve/*/tests/**/*.py]
max_line_length = unset

[*.md]
indent_size = unset
max_line_length = unset

# Excalidraw diagrams — JSON with embedded base64; line length not enforceable
[*.excalidraw]
max_line_length = unset

# MegaLinter config — regex patterns cannot be split
[.mega-linter.yml]
max_line_length = unset

[uv.lock]
max_line_length = unset

# Keep data files minified — do not reformat
[store/**]
indent_size = unset
insert_final_newline = false
max_line_length = unset
trim_trailing_whitespace = false
